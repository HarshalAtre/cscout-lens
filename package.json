{
  "name": "cscout-lens",
  "displayName": "CScout Lens",
  "description": "VS Code workspace analyzer powered by CScout",
  "version": "0.1.0",
  "publisher": "cscout",
  "license": "GPL-3.0",
  "engines": { "vscode": "^1.85.0" },
  "categories": ["Programming Languages", "Linters"],
  "activationEvents": [
    "onLanguage:c",
    "workspaceContains:**/*.cs"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      { "command": "cscoutLens.connect",          "title": "CScout Lens: Connect to Analyzer" },
      { "command": "cscoutLens.disconnect",        "title": "CScout Lens: Disconnect" },
      { "command": "cscoutLens.refresh",           "title": "CScout Lens: Refresh Analysis", "icon": "$(sync)" },
      { "command": "cscoutLens.showFileAnalysis",  "title": "CScout Lens: Analyze Current File" },
      { "command": "cscoutLens.focusFunction",     "title": "CScout Lens: Map Function Calls" },
      { "command": "cscoutLens.listUnused",        "title": "CScout Lens: List Unused Symbols", "icon": "$(warning)" }
    ],
    "viewsContainers": {
      "activitybar": [{
        "id": "cscoutLensBar",
        "title": "CScout Lens",
        "icon": "$(telescope)"
      }]
    },
    "views": {
      "cscoutLensBar": [
        { "id": "cscoutLens.workspace",    "name": "Workspace"      },
        { "id": "cscoutLens.symbols",      "name": "Symbol Browser" },
        { "id": "cscoutLens.fileAnalysis", "name": "File Analysis"  },
        { "id": "cscoutLens.functionMap",  "name": "Function Map"   }
      ]
    },
    "configuration": {
      "title": "CScout Lens",
      "properties": {
        "cscoutLens.host": {
          "type": "string",
          "default": "localhost",
          "description": "Hostname where CScout is running"
        },
        "cscoutLens.port": {
          "type": "number",
          "default": 8081,
          "description": "Port where CScout is listening (default: 8081)"
        }
      }
    },
    "menus": {
      "editor/context": [
        { "command": "cscoutLens.showFileAnalysis", "when": "resourceLangId == c", "group": "cscoutLens" },
        { "command": "cscoutLens.focusFunction",    "when": "resourceLangId == c", "group": "cscoutLens" }
      ],
      "view/title": [
        { "command": "cscoutLens.listUnused", "when": "view == cscoutLens.symbols",   "group": "navigation" },
        { "command": "cscoutLens.refresh",    "when": "view == cscoutLens.workspace", "group": "navigation" }
      ]
    }
  },
  "scripts": {
    "compile":           "tsc -p ./",
    "watch":             "tsc -watch -p ./",
    "vscode:prepublish": "npm run compile"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/node":   "^20.11.0",
    "typescript":    "^5.3.0"
  }
}
